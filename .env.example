# ══════════════════════════════════════════════════════════════
# 电商智能客服 RAG 系统 — 环境变量样例
#
# 使用:  cp .env.example .env   然后按需填写
# 字段名与 src/config.py 的 Settings 一一对应（大小写不敏感）
# 标「必填」的留空会导致启动失败或功能不可用
# ══════════════════════════════════════════════════════════════

# ── 对话 LLM：DeepSeek（意图分类 / 回答生成 / 幻觉断言 / 查询改写）──
# 必填
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEFAULT_MODEL=deepseek-chat
# FALLBACK_MODEL=qwen-plus

# ── 本地 Embedding / Reranker（BAAI bge 系列，权重需随部署提供）──
# 必填：留空则 Embedder / Reranker 初始化时抛 RuntimeError，服务拒绝启动
# 权重下载方式见 README「本地模型」章节
# Docker 部署时需把 local_models/ 挂载进容器（见 docker-compose-rag.yml）
EMBEDDING_MODEL_PATH=local_models/models/BAAI--bge-small-zh-v1.5/snapshots/master
RERANKER_MODEL_PATH=local_models/models/BAAI--bge-reranker-base/snapshots/master
EMBEDDING_DIM=512
RERANKER_TOP_N=5
RERANKER_ENABLED=true

# ── 向量库 Chroma（本地持久化，无需外部服务）──
# CHROMA_PERSIST_DIR=./data/chroma
# CHROMA_COLLECTION=ecommerce_knowledge

# ── 文档解析 ──
# OCR 走本地 RapidOCR，无需任何云端 Key
OCR_MODEL=rapidocr
PDF_OCR_ENABLED=true
PDF_MAX_PAGES=50
# DOC_PARSE_TIMEOUT=120

# ── 联网搜索（检索降级链 L4）──
# 智谱与 Tavily 都配置时：智谱优先，Tavily 备选
# 两者都留空 → 联网环节静默跳过，不影响主流程
WEB_SEARCH_ENABLED=true
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_WEB_SEARCH_ENABLED=true
# TAVILY_API_KEY=your_tavily_api_key_here

# ── 图片理解 VLM（可选，仅图片类文档解析使用）──
# SILICONFLOW_API_KEY=your_siliconflow_api_key_here
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_VL_MODEL=Qwen/Qwen3-VL-8B-Instruct
# VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ── Redis 缓存（可选：不可达时自动跳过缓存，不阻塞主流程）──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── 订单/物流数据库 MySQL（copilot 库，只读账号）──
# 可选：不可达时订单/物流查询自动降级为 mock 数据
# MYSQL_HOST=192.168.x.x
# MYSQL_PORT=3306
# MYSQL_USER=agent_ro
# MYSQL_PASSWORD=your_mysql_password_here
# MYSQL_DATABASE=copilot

# ── 服务端口 ──
API_HOST=0.0.0.0
API_PORT=8000

# ── 鉴权（模块33 JWT）──
# 必填：为空则应用启动校验直接拒绝启动
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=720

# 内置 demo 用户（明文弱密码，仅演示/测试）。生产必须设为 false
ENABLE_DEMO_USERS=true
# demo 用户 JSON：role = admin|vip|member|normal；access_level = vip|member|public
# DEMO_USERS={"admin":{"password":"admin123","role":"admin","access_level":"vip"},"vip":{"password":"vip123","role":"vip","access_level":"vip"},"member":{"password":"member123","role":"member","access_level":"member"},"normal":{"password":"normal123","role":"normal","access_level":"public"}}

# ── Gradio UI 鉴权（7860 知识库入库 / 7861 用户聊天 / 7862 管理台）──
# 必填：为空则 UI 拒绝无鉴权启动
GRADIO_USERNAME=admin
GRADIO_PASSWORD=your_gradio_password_here

# ── 聊天界面（7861）调试模式 ──
# true  → 状态栏显示意图、置信度、检索条数与来源，并展开技术实现说明（演示/排障用）
# false → 只显示对客户有意义的服务状态（默认；面向真实客户应保持 false）
# 该值仅为开关的初始状态，界面上仍可临时切换
UI_DEBUG_MODE=false

# ── UI 内部调用 API 的服务账号 ──
# Docker 部署无需设置 API_BASE_URL（默认 http://rag-api:8000）
# 本地 venv 运行需改成 http://127.0.0.1:8000
API_USERNAME=admin
API_PASSWORD=your_api_account_password_here
# API_BASE_URL=http://127.0.0.1:8000

# ── CORS 白名单（逗号分隔，可选）──
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:7860,http://localhost:7861,http://localhost:7862
